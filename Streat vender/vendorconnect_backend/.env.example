# ─────────────────────────────────────────────────────────────────────────────
# VendorConnect India — Environment Variables Example
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-django-key-change-this-in-production
DEBUG=True

# ── Database ─────────────────────────────────────────────────────────────────
# Leave blank → uses SQLite locally (db.sqlite3)
# Set to a PostgreSQL URL for Railway / staging / production:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# ── Cloudinary (Media Storage) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── CORS / Frontend ──────────────────────────────────────────────────────────
# URL of your React / Next.js frontend (no trailing slash)
CLIENT_URL=http://localhost:3000

# ── JWT ──────────────────────────────────────────────────────────────────────
# Used as the SIGNING_KEY for SimpleJWT tokens
JWT_SECRET=your-jwt-signing-secret-change-this-in-production
